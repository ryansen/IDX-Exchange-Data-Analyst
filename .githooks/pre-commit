#!/bin/sh
set -eu

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$staged_files" ]; then
  exit 0
fi

blocked_files="$(printf '%s\n' "$staged_files" | grep -Ev '(^|/)\.env\.example$' | grep -Ei '(^|/)(csv/|reports/|.*\.(csv|tsv|parquet|feather|sqlite|sqlite3|db|xlsx|xls)$|\.env($|\.)|.*\.(pem|key|p12|pfx)$)' || true)"

if [ -n "$blocked_files" ]; then
  echo "Commit blocked: remove local data or secret files from the index first." >&2
  echo "$blocked_files" >&2
  exit 1
fi

secret_hits="$(git diff --cached --unified=0 -- . ':(exclude).githooks/pre-commit' | grep -Ei "^\+.*(api[_-]?key|secret|password|token)[A-Za-z0-9_ -]*[=:][[:space:]]*['\"][^'\"]{12,}['\"]|^\+.*Bearer[[:space:]]+[A-Za-z0-9._~+/-]{12,}" || true)"

if [ -n "$secret_hits" ]; then
  echo "Commit blocked: staged diff looks like it may contain a secret." >&2
  echo "$secret_hits" >&2
  exit 1
fi
